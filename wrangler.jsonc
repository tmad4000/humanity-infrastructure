// Required Worker secrets, provisioned with wrangler-gcp secret bulk:
// ADMIN_EXPORT_TOKEN — owner-only CSV authorization.
// RATE_LIMIT_SALT — private IP hash salt for signup rate limiting.
// Values live only in Cloudflare Worker secrets, never vars or source control.
// Wrangler preserves existing Worker secrets on upload/deploy.
{
  "name": "humanity-infrastructure",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "SIGNUPS",
      "database_name": "humanity-infrastructure-signups",
      "database_id": "848844f3-4379-4cb6-a7a3-a39a7bfc3624"
    }
  ],
  "env": {
    "preview": {
      "name": "humanity-infrastructure-signups-preview",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "SIGNUPS",
          "database_name": "humanity-infrastructure-signups-preview",
          "database_id": "374eb125-c67a-46bf-b73a-4a949afe83b6"
        }
      ]
    }
  }
}
